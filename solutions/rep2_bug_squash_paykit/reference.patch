diff --git a/paykit/ledger.py b/paykit/ledger.py
index c38bda8..a10fc14 100644
--- a/paykit/ledger.py
+++ b/paykit/ledger.py
@@ -28,16 +28,19 @@ class Ledger:
         return sum(
             charge.amount - charge.refunded
             for charge in self._charges.values()
-            if charge.currency == currency
+            if charge.status == "succeeded" and charge.currency == currency
         )
 
     def can_refund(self, charge_id, amount):
         """True when ``amount`` can still be refunded on the charge."""
         charge = self.get(charge_id)
-        return 0 < amount <= charge.amount
+        remaining = charge.amount - charge.refunded
+        return 0 < amount <= remaining
 
     def refund(self, charge_id, amount):
         """Refund part of a charge and return the new refunded total."""
+        if not self.can_refund(charge_id, amount):
+            raise ValueError(f"cannot refund {amount} on {charge_id}")
         charge = self.get(charge_id)
         charge.refunded += amount
         return charge.refunded
diff --git a/paykit/money.py b/paykit/money.py
index 33ff7ef..6bb36f8 100644
--- a/paykit/money.py
+++ b/paykit/money.py
@@ -54,6 +54,8 @@ class Money:
     def __add__(self, other):
         if not isinstance(other, Money):
             return NotImplemented
+        if other.currency != self.currency:
+            raise ValueError(f"cannot add {other.currency} to {self.currency}")
         return Money(self.minor_units + other.minor_units, self.currency)
 
     def convert(self, to_currency, rates):
@@ -64,8 +66,9 @@ class Money:
         to_currency = to_currency.lower()
         if to_currency not in EXPONENT:
             raise ValueError(f"unsupported currency: {to_currency!r}")
-        usd = Decimal(self.minor_units) / rate_for(rates, self.currency)
-        minor = usd * rate_for(rates, to_currency)
+        usd = self.to_decimal() / rate_for(rates, self.currency)
+        amount = usd * rate_for(rates, to_currency)
+        minor = amount.scaleb(EXPONENT[to_currency])
         return Money(
             int(minor.quantize(Decimal(1), rounding=ROUND_HALF_UP)), to_currency
         )
