@@ -0,0 +1,60 @@
+"""Distance, time and speed statistics for a ride file."""
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+from .geo import haversine_m, valid_position
+from .ride import _track_feature
+from .timefmt import parse_utc
+
+
+def _number(value) -> bool:
+    return isinstance(value, (int, float)) and not isinstance(value, bool)
+
+
+def _usable(position, stamp):
+    if not isinstance(position, list) or len(position) not in (2, 3):
+        return None
+    if not all(_number(v) for v in position):
+        return None
+    lon, lat = float(position[0]), float(position[1])  # GeoJSON order
+    if not valid_position(lat, lon):
+        return None
+    try:
+        moment = parse_utc(stamp)
+    except (ValueError, TypeError):
+        return None
+    return lat, lon, moment
+
+
+def ride_stats(path) -> dict:
+    feature = _track_feature(json.loads(Path(path).read_text(encoding="utf-8")))
+    coords = (feature.get("geometry") or {}).get("coordinates") or []
+    times = (feature.get("properties") or {}).get("times") or []
+    used, skipped = [], []
+    for i, position in enumerate(coords):
+        point = _usable(position, times[i] if i < len(times) else None)
+        if point is None:
+            skipped.append(i)
+        else:
+            used.append(point)
+    distance = elapsed = max_speed = 0.0
+    if len(used) >= 2:
+        elapsed = (used[-1][2] - used[0][2]).total_seconds()
+        for (lat1, lon1, t1), (lat2, lon2, t2) in zip(used, used[1:]):
+            d = haversine_m(lat1, lon1, lat2, lon2)
+            distance += d
+            dt = (t2 - t1).total_seconds()
+            if dt > 0:
+                max_speed = max(max_speed, d / dt * 3.6)
+    avg = distance / elapsed * 3.6 if elapsed > 0 else 0.0
+    return {
+        "points": len(coords),
+        "used_points": len(used),
+        "skipped_points": skipped,
+        "elapsed_s": round(elapsed, 1),
+        "distance_m": round(distance, 1),
+        "avg_speed_kmh": round(avg, 2),
+        "max_speed_kmh": round(max_speed, 2),
+    }
