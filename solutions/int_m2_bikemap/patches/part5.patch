+++ b/tests/test_ride_tools.py
@@ -0,0 +1,67 @@
+import json
+from pathlib import Path
+
+import pytest
+
+from bikemap.errors import ApiError
+from bikemap.landmarks import nearest_landmarks
+from bikemap.models import Ride, TrackPoint
+from bikemap.render import render_ride
+from bikemap.ride import load_ride
+from bikemap.stats import ride_stats
+from mock_map import DEFAULT_API_KEY, MockMapServer
+
+DATA = Path(__file__).resolve().parent.parent / "data"
+
+
+def write_ride(tmp_path, coords, times):
+    doc = {"type": "FeatureCollection", "features": [{"type": "Feature",
+           "properties": {"name": "t", "times": times},
+           "geometry": {"type": "LineString", "coordinates": coords}}]}
+    path = tmp_path / "ride.geojson"
+    path.write_text(json.dumps(doc))
+    return path
+
+
+def test_load_ride_swaps_to_lat_lon():
+    ride = load_ride(DATA / "ride_canal_loop.geojson")
+    assert (ride.points[0].lat, ride.points[0].lon) == (52.379185, 4.900061)
+    assert ride.points[0].time.tzinfo is not None
+
+
+def test_render_sends_lat_first(tmp_path):
+    ride = load_ride(DATA / "ride_canal_loop.geojson")
+    with MockMapServer() as api:
+        render_id = render_ride(ride, tmp_path / "r.png", base_url=api.url, api_key=DEFAULT_API_KEY)
+        drawn = api.renders[-1]["drawn"]
+    assert render_id.startswith("rnd_")
+    assert drawn["segments"][0]["from"] == [52.379185, 4.900061]
+
+
+def test_render_retries_then_fails(tmp_path):
+    ride = Ride("x", [TrackPoint(1.0, 2.0), TrackPoint(1.1, 2.1)])
+    scenario = {"faults": [{"method": "POST", "path": "/v1/render", "status": 503, "times": 5}]}
+    with MockMapServer(scenario) as api:
+        with pytest.raises(ApiError):
+            render_ride(ride, tmp_path / "r.png", base_url=api.url, api_key=DEFAULT_API_KEY)
+        assert len(api.requests) == 3
+    assert not (tmp_path / "r.png").exists()
+
+
+def test_nearest_tie_goes_to_lowest_id():
+    ride = Ride("x", [TrackPoint(10.0, 20.0)])
+    scenario = {"landmarks": [{"id": "lm_b", "name": "B", "coordinates": [10.0, 20.01]},
+                              {"id": "lm_a", "name": "A", "coordinates": [10.0, 19.99]},
+                              {"id": "lm_c", "name": "C", "coordinates": None}]}
+    with MockMapServer(scenario) as api:
+        (row,) = nearest_landmarks(ride, base_url=api.url, api_key=DEFAULT_API_KEY)
+    assert row["landmark_id"] == "lm_a"
+
+
+def test_stats_skip_glitches(tmp_path):
+    path = write_ride(tmp_path, [[0.0, 0.0], [0.0, 0.01], [0.01], [0.0, 0.02]],
+                      ["2026-01-01T00:00:00Z", "2026-01-01T00:01:00Z", "2026-01-01T00:02:00Z", None])
+    stats = ride_stats(path)
+    assert stats["skipped_points"] == [2, 3]
+    assert stats["elapsed_s"] == 60.0
+    assert stats["distance_m"] == pytest.approx(1111.9, abs=0.1)
