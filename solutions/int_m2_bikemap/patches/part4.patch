index 0000000..61f3c94
--- /dev/null
+++ b/bikemap/mapapi.py
@@ -0,0 +1,41 @@
+"""Pathfinder API calls with authentication and retries."""
+from __future__ import annotations
+
+import time
+from typing import Any, Callable
+
+from . import http
+from .errors import TransportError
+from .http import HttpResponse
+
+MAX_ATTEMPTS = 3
+RETRYABLE_STATUS = {500, 502, 503, 504}
+BACKOFF_SECONDS = (0.1, 0.25)
+
+
+class MapApi:
+    def __init__(self, base_url: str, api_key: str, timeout: float = 5.0,
+                 sleep: Callable[[float], None] = time.sleep):
+        self.base_url = base_url.rstrip("/")
+        self.api_key = api_key
+        self.timeout = timeout
+        self.sleep = sleep
+
+    def request(self, method: str, path: str, json_body: Any = None) -> HttpResponse:
+        """Send with retries; returns a 2xx response or raises ApiError/TransportError."""
+        url = self.base_url + path
+        for attempt in range(1, MAX_ATTEMPTS + 1):
+            last = attempt == MAX_ATTEMPTS
+            try:
+                response = http.send(method, url, headers={"X-Api-Key": self.api_key},
+                                     json_body=json_body, timeout=self.timeout)
+            except TransportError:
+                if last:
+                    raise
+            else:
+                if response.ok:
+                    return response
+                if response.status not in RETRYABLE_STATUS or last:
+                    response.raise_for_status()
+            self.sleep(BACKOFF_SECONDS[min(attempt - 1, len(BACKOFF_SECONDS) - 1)])
+        raise AssertionError("unreachable")
