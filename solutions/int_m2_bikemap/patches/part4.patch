--- /dev/null
+++ b/bikemap/landmarks.py
@@ -0,0 +1,65 @@
+"""Nearest Pathfinder landmark for each track point."""
+from __future__ import annotations
+
+from urllib.parse import urlencode
+
+from .geo import haversine_m, valid_position
+from .mapapi import MapApi
+from .models import Landmark, Ride
+
+PAGE_SIZE = 10  # API maximum
+
+
+def _number(value) -> bool:
+    return isinstance(value, (int, float)) and not isinstance(value, bool)
+
+
+def parse_landmark(record) -> Landmark | None:
+    """Return a Landmark, or None when the record is unusable."""
+    if not isinstance(record, dict):
+        return None
+    lid, name, coords = record.get("id"), record.get("name"), record.get("coordinates")
+    if not isinstance(lid, str) or not lid or not isinstance(name, str):
+        return None
+    if not isinstance(coords, list) or len(coords) != 2 or not all(_number(c) for c in coords):
+        return None
+    lat, lon = float(coords[0]), float(coords[1])  # API order: lat, lon
+    if not valid_position(lat, lon):
+        return None
+    return Landmark(lid, name, lat, lon)
+
+
+def fetch_landmarks(api: MapApi) -> tuple[list[Landmark], list]:
+    usable, skipped, token = [], [], None
+    while True:
+        params = {"limit": PAGE_SIZE}
+        if token:
+            params["page_token"] = token
+        page = api.request("GET", "/v1/landmarks?" + urlencode(params)).json()
+        for record in page.get("data", []):
+            landmark = parse_landmark(record)
+            if landmark is None:
+                skipped.append(record)
+            else:
+                usable.append(landmark)
+        token = page.get("next_page_token")
+        if not token:
+            return usable, skipped
+
+
+def nearest_landmarks(ride: Ride, *, base_url: str, api_key: str, timeout: float = 2.0) -> list[dict]:
+    landmarks, _ = fetch_landmarks(MapApi(base_url, api_key, timeout=timeout))
+    rows = []
+    for index, point in enumerate(ride.points):
+        best = None
+        for lm in landmarks:
+            d = haversine_m(point.lat, point.lon, lm.lat, lm.lon)
+            if best is None or (d, lm.id) < (best[0], best[1].id):
+                best = (d, lm)
+        rows.append({
+            "point_index": index,
+            "landmark_id": best[1].id if best else "",
+            "landmark_name": best[1].name if best else "",
+            "distance_m": round(best[0], 1) if best else None,
+        })
+    return rows
