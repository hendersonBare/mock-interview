@@ -0,0 +1,46 @@
+"""Read Trailhead ride exports (GeoJSON, see DOCS.md "Ride files")."""
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+from .models import Ride, TrackPoint
+from .timefmt import parse_utc
+
+
+def _track_feature(doc: dict) -> dict:
+    if doc.get("type") == "Feature":
+        return doc
+    for feature in doc.get("features", []):
+        if feature.get("geometry", {}).get("type") == "LineString":
+            return feature
+    raise ValueError("no LineString feature in ride file")
+
+
+def load_ride(path) -> Ride:
+    doc = json.loads(Path(path).read_text(encoding="utf-8"))
+    feature = _track_feature(doc)
+    props = feature.get("properties") or {}
+    coords = feature["geometry"]["coordinates"]
+    times = props.get("times") or []
+    points = []
+    for i, position in enumerate(coords):
+        lon, lat = float(position[0]), float(position[1])  # GeoJSON order: lon, lat
+        ele = float(position[2]) if len(position) > 2 else None
+        stamp = times[i] if i < len(times) else None
+        points.append(TrackPoint(lat=lat, lon=lon, time=parse_utc(stamp) if stamp else None, ele=ele))
+    return Ride(name=props.get("name", ""), points=points)
+
+
+def summary_lines(ride: Ride) -> list[str]:
+    from .geo import bounding_box
+
+    first, last = ride.points[0], ride.points[-1]
+    box = bounding_box((p.lat, p.lon) for p in ride.points)
+    return [
+        f"name: {ride.name}",
+        f"points: {len(ride.points)}",
+        f"start: {first.lat:.6f},{first.lon:.6f}",
+        f"end: {last.lat:.6f},{last.lon:.6f}",
+        "bbox: " + ",".join(f"{v:.6f}" for v in box),
+    ]
