@@ -0,0 +1,23 @@
+"""Render a ride with the Pathfinder render endpoint."""
+from __future__ import annotations
+
+from pathlib import Path
+
+from . import http
+from .models import Ride
+
+
+def build_render_request(ride: Ride, width: int, height: int) -> dict:
+    # the API wants [lat, lon]; ride files are [lon, lat]
+    points = [[p.lat, p.lon] for p in ride.points]
+    return {"width": width, "height": height, "paths": [{"points": points}]}
+
+
+def render_ride(ride: Ride, out_path, *, base_url: str, api_key: str,
+                width: int = 640, height: int = 480) -> str:
+    body = build_render_request(ride, width, height)
+    response = http.send("POST", base_url.rstrip("/") + "/v1/render",
+                         headers={"X-Api-Key": api_key}, json_body=body)
+    response.raise_for_status()
+    Path(out_path).write_bytes(response.body)
+    return response.header("X-Render-Id", "")
