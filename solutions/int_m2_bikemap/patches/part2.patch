+"""Render a ride with the Pathfinder render endpoint."""
+from __future__ import annotations
+
+from pathlib import Path
+
+import requests
+
+from .errors import ApiError, TransportError
+from .models import Ride
+
+
+def build_render_request(ride: Ride, width: int, height: int) -> dict:
+    # the API wants [lat, lon]; ride files are [lon, lat]
+    points = [[p.lat, p.lon] for p in ride.points]
+    return {"width": width, "height": height, "paths": [{"points": points}]}
+
+
+def _api_error(response: requests.Response) -> ApiError:
+    try:
+        message = response.json().get("error", {}).get("message", "")
+    except (ValueError, AttributeError):
+        message = response.text[:200]
+    return ApiError(response.status_code, message)
+
+
+def render_ride(ride: Ride, out_path, *, base_url: str, api_key: str,
+                width: int = 640, height: int = 480) -> str:
+    body = build_render_request(ride, width, height)
+    try:
+        response = requests.post(base_url.rstrip("/") + "/v1/render",
+                                 headers={"X-Api-Key": api_key}, json=body, timeout=10)
+    except requests.RequestException as exc:
+        raise TransportError(f"POST /v1/render: {exc}") from exc
+    if not 200 <= response.status_code < 300:
+        raise _api_error(response)
+    Path(out_path).write_bytes(response.content)  # PNG bytes, not JSON
+    return response.headers.get("X-Render-Id", "")
