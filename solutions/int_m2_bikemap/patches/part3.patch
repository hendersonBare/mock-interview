@@ -0,0 +1,51 @@
+"""Pathfinder API calls with authentication and retries."""
+from __future__ import annotations
+
+import time
+from typing import Any, Callable
+
+import requests
+
+from .errors import ApiError, TransportError
+
+MAX_ATTEMPTS = 3
+RETRYABLE_STATUS = {500, 502, 503, 504}
+BACKOFF_SECONDS = (0.1, 0.25)
+
+
+def api_error(response: requests.Response) -> ApiError:
+    try:
+        message = response.json().get("error", {}).get("message", "")
+    except (ValueError, AttributeError):
+        message = response.text[:200]
+    return ApiError(response.status_code, message)
+
+
+class MapApi:
+    def __init__(self, base_url: str, api_key: str, timeout: float = 5.0,
+                 sleep: Callable[[float], None] = time.sleep):
+        self.base_url = base_url.rstrip("/")
+        self.timeout = timeout
+        self.sleep = sleep
+        self.session = requests.Session()
+        self.session.headers["X-Api-Key"] = api_key
+
+    def request(self, method: str, path: str, *, params: dict | None = None,
+                json_body: Any = None) -> requests.Response:
+        """Send with retries; returns a 2xx response or raises ApiError/TransportError."""
+        url = self.base_url + path
+        for attempt in range(1, MAX_ATTEMPTS + 1):
+            last = attempt == MAX_ATTEMPTS
+            try:
+                response = self.session.request(method, url, params=params, json=json_body,
+                                                timeout=self.timeout)
+            except requests.RequestException as exc:
+                if last:
+                    raise TransportError(f"{method} {path}: {exc}") from exc
+            else:
+                if 200 <= response.status_code < 300:
+                    return response
+                if response.status_code not in RETRYABLE_STATUS or last:
+                    raise api_error(response)
+            self.sleep(BACKOFF_SECONDS[min(attempt - 1, len(BACKOFF_SECONDS) - 1)])
+        raise AssertionError("unreachable")
