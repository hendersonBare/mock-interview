@@ -0,0 +1,29 @@
+"""Render a ride with the Pathfinder render endpoint."""
+from __future__ import annotations
+
+from pathlib import Path
+
+from .mapapi import MapApi
+from .models import Ride
+
+EVEN_COLOR = "#e4572e"
+ODD_COLOR = "#2e86ab"
+
+
+def build_render_request(ride: Ride, width: int, height: int, annotate: bool = False) -> dict:
+    # the API wants [lat, lon]; ride files are [lon, lat]
+    points = [[p.lat, p.lon] for p in ride.points]
+    path: dict = {"points": points}
+    body = {"width": width, "height": height, "paths": [path]}
+    if annotate:
+        path["colors"] = [EVEN_COLOR, ODD_COLOR]
+        body["markers"] = [{"at": points[0], "kind": "start"}, {"at": points[-1], "kind": "end"}]
+    return body
+
+
+def render_ride(ride: Ride, out_path, *, base_url: str, api_key: str,
+                width: int = 640, height: int = 480, annotate: bool = False) -> str:
+    body = build_render_request(ride, width, height, annotate)
+    response = MapApi(base_url, api_key).request("POST", "/v1/render", json_body=body)
+    Path(out_path).write_bytes(response.content)  # PNG bytes, not JSON
+    return response.headers.get("X-Render-Id", "")
diff --git a/bikemap/ride.py b/bikemap/ride.py
new file mode 100644
index 0000000..f279d65
--- /dev/null
+++ b/bikemap/ride.py
@@ -0,0 +1,46 @@
+"""Read Trailhead ride exports (GeoJSON, see DOCS.md "Ride files")."""
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+from .models import Ride, TrackPoint
+from .timefmt import parse_utc
+
+
+def _track_feature(doc: dict) -> dict:
+    if doc.get("type") == "Feature":
+        return doc
+    for feature in doc.get("features", []):
+        if feature.get("geometry", {}).get("type") == "LineString":
+            return feature
+    raise ValueError("no LineString feature in ride file")
+
+
+def load_ride(path) -> Ride:
+    doc = json.loads(Path(path).read_text(encoding="utf-8"))
+    feature = _track_feature(doc)
+    props = feature.get("properties") or {}
+    coords = feature["geometry"]["coordinates"]
+    times = props.get("times") or []
+    points = []
+    for i, position in enumerate(coords):
+        lon, lat = float(position[0]), float(position[1])  # GeoJSON order: lon, lat
+        ele = float(position[2]) if len(position) > 2 else None
+        stamp = times[i] if i < len(times) else None
+        points.append(TrackPoint(lat=lat, lon=lon, time=parse_utc(stamp) if stamp else None, ele=ele))
+    return Ride(name=props.get("name", ""), points=points)
+
+
+def summary(ride: Ride) -> str:
+    from .geo import bounding_box
+
+    first, last = ride.points[0], ride.points[-1]
+    box = bounding_box((p.lat, p.lon) for p in ride.points)
+    return "\n".join([
+        f"name: {ride.name}",
+        f"points: {len(ride.points)}",
+        f"start: {first.lat:.6f},{first.lon:.6f}",
+        f"end: {last.lat:.6f},{last.lon:.6f}",
+        "bbox: " + ",".join(f"{v:.6f}" for v in box),
+    ])
